# Copy to .env for local development. NEVER commit .env.
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string   # python -c "import secrets; print(secrets.token_hex(32))"

# LLM providers (set at least one). Keys stay on the server.
LLM_PROVIDER=groq                # default provider: gemini | groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# MongoDB Atlas. If empty in development, an in-memory store is used (data is lost on restart).
MONGODB_URI=
MONGODB_DB_NAME=diagramforge

# PlantUML renderer. Diagram text is sent to this server; self-host for private data.
PLANTUML_SERVER=https://www.plantuml.com/plantuml

# Optional tuning
RATE_LIMIT_GENERATE=10
RATE_LIMIT_PROJECT=3
MAX_PROMPT_CHARS=8000
